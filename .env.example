# Strapi CMS Secrets (generate new ones for production!)
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Google Gemini API (event-link filtering + structured gig extraction)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Model tier. Defaults to gemini-flash-lite-latest (cheapest). Bump to
# gemini-flash-latest if extraction/taste-filter quality regresses.
# GEMINI_MODEL=gemini-flash-lite-latest

# Extraction cache (big cost saver, on by default). Skips the Gemini call for pages
# whose content is unchanged since a recent run, replaying the cached gigs. Persisted
# in the Strapi crawl-cache single-type (Postgres) — no files/volumes. Set to false to
# disable. Entries older than CRAWLER_CACHE_TTL_DAYS are re-extracted regardless.
# CRAWLER_CACHE_ENABLED=true
# CRAWLER_CACHE_TTL_DAYS=7

# Strapi API Token for Gig Crawler
# Create this in Strapi admin panel (Settings > API Tokens)
# Needs permissions: gig.create, gig.find, gig.update, venue.create, venue.find,
#   crawl-cache.find, crawl-cache.update
STRAPI_API_TOKEN=your_strapi_api_token_here

# Discovery is driven by the curated source registry (apps/gig-crawler/src/models/sources.ts).
# Brave search is no longer used; BRAVE_API_KEY is optional and ignored.
