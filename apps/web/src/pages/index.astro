---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import GigRow from '../components/GigRow.astro';
import { fetchGigs, getMonthLabel, monthKey, type Gig } from '../lib/gigs';

let gigs: Gig[] = [];
let error: string | null = null;

/** Gigs grouped into calendar months, so each month renders as its own section
 * (needed for the sticky month header: it stays pinned while its section scrolls,
 * then the next month's header pushes it away). */
function groupByMonth(list: Gig[]): { label: string; gigs: Gig[] }[] {
  const months: { key: string; label: string; gigs: Gig[] }[] = [];
  for (const gig of list) {
    const key = monthKey(gig.date);
    const last = months[months.length - 1];
    if (last && last.key === key) {
      last.gigs.push(gig);
    } else {
      months.push({ key, label: getMonthLabel(gig.date), gigs: [gig] });
    }
  }
  return months;
}

// Server-rendered: this runs per request, so gigs stay fresh without a rebuild.
// The page only ever fetches Strapi server-side, so a single URL covers every
// environment (Railway private networking in prod, localhost in dev) - there's
// no browser-facing use, hence no public/internal split.
const strapiUrl = process.env.STRAPI_API_URL ?? 'http://localhost:1337';

try {
  // Retries a few times so a transient CMS blip (redeploy, cold start) doesn't
  // surface as an error the user has to refresh past.
  gigs = await fetchGigs(strapiUrl);
  // Cache successful responses only (5 min at the CDN/proxy) so we don't hit
  // Strapi on every request - and never cache the error page below.
  Astro.response.headers.set('Cache-Control', 'public, max-age=300, stale-while-revalidate=600');
} catch (e) {
  error = 'Could not load gigs. Make sure the CMS is running.';
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Curated gigs in Athens, Greece" />
    <title>Athens Ears - Curated gigs in Athens</title>
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <div class="mx-auto max-w-6xl px-2 py-1.5 sm:px-6 sm:py-3 lg:max-w-7xl lg:px-8">
      <div
        class="rounded-xl border border-line bg-surface px-3 py-8 shadow-sm shadow-ink/5 sm:rounded-2xl sm:px-8 sm:py-12 lg:px-12 lg:py-14"
      >
        <SiteHeader />

        <main class="mt-5 sm:mt-7">
          {
            error && (
              <div class="rounded-xl border border-accent-strong/30 bg-accent/5 px-4 py-3 font-medium text-accent-strong">
                {error}
              </div>
            )
          }

          {!error && gigs.length === 0 && <p class="text-lg text-muted">No upcoming gigs found.</p>}

          {
            !error && gigs.length > 0 && (
              <div>
                {groupByMonth(gigs).map((month, mi) => (
                  <section class:list={[mi > 0 && 'mt-8']}>
                    {/* z-20: must clear the rows' interior z-10 layers (the venue links
                        raised above each row's stretched ticket link), or those paint
                        over the sticky header as rows scroll beneath it. */}
                    <div class="sticky top-0 z-20 -mx-3 mb-1 border-b border-line bg-surface px-3 py-2 sm:-mx-4 sm:px-4">
                      <span class="text-xl font-extrabold uppercase tracking-[0.2em] text-accent">
                        {month.label}
                      </span>
                    </div>
                    {month.gigs.map((gig, i) => (
                      <GigRow gig={gig} divider={i > 0} />
                    ))}
                  </section>
                ))}
              </div>
            )
          }
        </main>

        <SiteFooter />
      </div>
    </div>
  </body>
</html>
