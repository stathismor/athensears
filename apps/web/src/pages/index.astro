---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import GigRow from '../components/GigRow.astro';
import { fetchGigs, getMonthLabel, monthKey, type Gig } from '../lib/gigs';

let gigs: Gig[] = [];
let error: string | null = null;

// Server-rendered: this runs per request, so gigs stay fresh without a rebuild.
// Prefer the server-only internal URL (Railway private networking), then the
// public URL, then localhost for dev.
const strapiUrl =
  (typeof process !== 'undefined' && process.env.STRAPI_INTERNAL_URL) ||
  import.meta.env.PUBLIC_STRAPI_URL ||
  'http://localhost:1337';

try {
  // Retries a few times so a transient CMS blip (redeploy, cold start) doesn't
  // surface as an error the user has to refresh past.
  gigs = await fetchGigs(strapiUrl);
  // Cache successful responses only (5 min at the CDN/proxy) so we don't hit
  // Strapi on every request - and never cache the error page below.
  Astro.response.headers.set('Cache-Control', 'public, max-age=300, stale-while-revalidate=600');
} catch (e) {
  error = 'Could not load gigs. Make sure the CMS is running.';
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Curated gigs in Athens, Greece" />
    <title>Athens Ears - Curated gigs in Athens</title>
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <div class="mx-auto max-w-6xl px-3 py-1.5 sm:px-6 sm:py-3 lg:max-w-7xl lg:px-8">
      <div
        class="rounded-xl border border-line bg-surface px-6 py-8 shadow-sm shadow-ink/5 sm:rounded-2xl sm:px-10 sm:py-12 lg:px-14 lg:py-14"
      >
        <SiteHeader />

        <main class="mt-5 sm:mt-7">
          {
            error && (
              <div class="rounded-xl border border-accent-strong/30 bg-accent/5 px-4 py-3 font-medium text-accent-strong">
                {error}
              </div>
            )
          }

          {!error && gigs.length === 0 && <p class="text-lg text-muted">No upcoming gigs found.</p>}

          {
            !error && gigs.length > 0 && (
              <div>
                {gigs.map((gig, i) => {
                  const newMonth = i === 0 || monthKey(gig.date) !== monthKey(gigs[i - 1].date);
                  return (
                    <Fragment>
                      {newMonth && (
                        <div
                          class:list={[
                            '-mx-4 mb-1 px-4',
                            i === 0 ? 'mt-0' : 'mt-6 border-t border-line pt-5',
                          ]}
                        >
                          <span class="text-sm font-bold uppercase tracking-[0.25em] text-muted">
                            {getMonthLabel(gig.date)}
                          </span>
                        </div>
                      )}
                      <GigRow gig={gig} divider={!newMonth} />
                    </Fragment>
                  );
                })}
              </div>
            )
          }
        </main>

        <SiteFooter />
      </div>
    </div>
  </body>
</html>
