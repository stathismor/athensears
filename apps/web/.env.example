# Strapi CMS URL used by the server-rendered web app.
#
# The page fetches gigs server-side on each request, preferring the server-only
# internal URL (e.g. Railway private networking), then the public URL.
#
# Local dev defaults to http://localhost:1337 if neither is set.

# Server-only (not exposed to the browser). Use the internal/private CMS URL.
STRAPI_INTERNAL_URL=http://localhost:1337

# Public fallback (safe to expose). Set to your CMS public URL in production.
PUBLIC_STRAPI_URL=http://localhost:1337
