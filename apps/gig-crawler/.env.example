# Strapi CMS (shared with gig-crawler)
STRAPI_API_URL=http://localhost:1337
STRAPI_API_TOKEN=your_strapi_token_here

# Discovery is driven by the curated source registry (src/models/sources.ts).
# Brave search is no longer used; BRAVE_API_KEY is optional and ignored.

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash-latest

# Server
PORT=3000
NODE_ENV=development

# Cron (same schedule as gig-crawler: 2 AM Athens time)
CRON_SCHEDULE=0 2 * * *
TZ=Europe/Athens

# Auth (optional - when set, /api/sync requires Authorization: Bearer <key>)
# SYNC_API_KEY=your_sync_api_key_here

# Logging
LOG_LEVEL=info
