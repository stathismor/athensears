# Strapi CMS (shared with gig-crawler)
STRAPI_API_URL=http://localhost:1337
# Token needs: gig + venue find/create/update, and crawl-cache find/update (extraction cache)
STRAPI_API_TOKEN=your_strapi_token_here

# Discovery is driven by the curated source registry (src/models/sources.ts).

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
# Model tier. Defaults to gemini-flash-lite-latest (cheapest). Uncomment/bump to
# gemini-flash-latest if extraction/taste-filter quality regresses.
# GEMINI_MODEL=gemini-flash-lite-latest

# Extraction cache (big cost saver, on by default). Skips the Gemini call for pages
# whose content is unchanged since a recent run; persisted in the Strapi crawl-cache
# single-type (Postgres). Set false to disable; entries expire after TTL days.
# CRAWLER_CACHE_ENABLED=true
# CRAWLER_CACHE_TTL_DAYS=7

# Server
PORT=3000
NODE_ENV=development

# Container/runtime timezone (affects log timestamps). The crawler has no built-in
# scheduler - trigger a sync via POST /api/sync (see README), e.g. from an external cron.
TZ=Europe/Athens

# Auth (optional - when set, /api/sync requires Authorization: Bearer <key>)
# SYNC_API_KEY=your_sync_api_key_here

# Logging
LOG_LEVEL=info
